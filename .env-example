# ======================================================

# Application

# ======================================================

VITE_APP_NAME=Chirp

# ======================================================

# Backend

# ======================================================

# ASP.NET Backend URL

VITE_PATH_TO_SERVER=https://localhost:7001/

# API Prefix

VITE_PATH_TO_API=api/

# Use mock API

VITE_USE_MOCK=false

# ======================================================

# Third-party APIs

# ======================================================

# GIPHY API Key

VITE_GIPHY_API_KEY=

# ======================================================

# Tweet

# ======================================================

VITE_MAX_TWEET_LENGTH=280

# ======================================================

# Media

# ======================================================

# Maximum attachments per tweet

VITE_MAX_MEDIA_ATTACHMENTS=4

# Maximum upload sizes (MB)

VITE_MAX_IMAGE_SIZE_MB=10
VITE_MAX_VIDEO_SIZE_MB=512
VITE_MAX_GIF_SIZE_MB=20

# Image compression

VITE_IMAGE_MAX_WIDTH=2048
VITE_IMAGE_QUALITY=0.8

# ======================================================

# Defaults

# ======================================================

VITE_DEFAULT_AVATAR=
VITE_DEFAULT_BANNER=

# ======================================================

# Features

# ======================================================

VITE_ENABLE_IMAGE_UPLOAD=true
VITE_ENABLE_VIDEO_UPLOAD=true
VITE_ENABLE_EMBED=true
VITE_ENABLE_GIFS=true
VITE_ENABLE_POLLS=false
VITE_ENABLE_LOCATION=false
